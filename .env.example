# Streamlit auth (simple)
APP_USERNAME=admin
APP_PASSWORD=admin123

# Backend model paths
MODEL_DIR=./model
MODEL_PIPELINE_FILENAME=churn_pipeline.joblib
MODEL_METADATA_FILENAME=churn_metadata.json

# Optional MySQL logging (app should run fine if disabled)
MYSQL_ENABLED=false
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=password
MYSQL_DATABASE=churn_platform

# Dashboard -> Backend base URL (local dev)
BACKEND_URL=http://localhost:8000